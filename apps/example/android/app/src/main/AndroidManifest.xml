<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />


    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Playback resumption after process death.

        media3 treats this declaration as the app's *promise* that it can resume
        ("Assume an app that intentionally puts a `MediaButtonReceiver` into the
        manifest has implemented some kind of resumption of the last recently
        played media item" — MediaSessionLegacyStub, media3 1.11.0). It is what
        makes `canResumePlaybackOnStart()` true, which is what makes the System
        UI offer a resumption card for this app at all, and it is what routes a
        headset/Bluetooth play to a receiver that can start the service into a
        dead process.

        Deliberately NOT merged in from @rn-media/media-session: it changes how
        media buttons are routed for every app that installs the package, and
        the feature it enables is opt-in (`android.playbackResumption`). Adding
        it is one copy-paste, and the library logs when it is missing.
      -->
      <receiver
        android:name="androidx.media3.session.MediaButtonReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent-filter>
      </receiver>

      <!--
        @rn-media/cast (pasted by hand — this is a bare-RN app; the Expo
        plugin writes exactly this pair for prebuild apps).

        The Cast framework instantiates the OptionsProvider reflectively at
        CastContext init; without the meta-data, initialize() resolves the
        typed 'unavailable'. No RECEIVER_APPLICATION_ID meta-data on purpose:
        the zero-config default is Google's Default Media Receiver.
      -->
      <meta-data
        android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
        android:value="com.rnmediacast.RnMediaCastOptionsProvider" />

      <!--
        Output-switcher stream transfer (Android 13+ system picker): this
        declaration is what lets the system move a stream phone ↔ receiver.
        Requirements checklist (developers.google.com/cast/docs/android_sender/
        output_switcher): this receiver, cast-framework ≥ 21.2 (we pin 22.3.1),
        a real media notification (we have one), and
        CastOptions.setRemoteToLocalEnabled — set in RnMediaCastOptionsProvider.
      -->
      <receiver
        android:name="androidx.mediarouter.media.MediaTransferReceiver"
        android:exported="true" />
    </application>
</manifest>
