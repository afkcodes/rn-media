{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "rnmediamediasession"
  ],
  "ios": {
    "iosModuleName": "RnMediaMediaSession"
  },
  "android": {
    "androidNamespace": [
      "rnmediamediasession"
    ],
    "androidCxxLibName": "RnMediaMediaSession"
  },
  "autolinking": {
    "RnMediaMediaSession": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRnMediaMediaSession"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRnMediaMediaSession"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}