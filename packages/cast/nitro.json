{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "rnmediacast"
  ],
  "ios": {
    "iosModuleName": "RnMediaCast"
  },
  "android": {
    "androidNamespace": [
      "rnmediacast"
    ],
    "androidCxxLibName": "RnMediaCast"
  },
  "autolinking": {
    "RnMediaCast": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRnMediaCast"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRnMediaCast"
      }
    },
    "RnMediaCastButton": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRnMediaCastButton"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRnMediaCastButton"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}