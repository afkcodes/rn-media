# Pinned prebuilt libmpv binaries for iOS — SINGLE SOURCE OF TRUTH.
#
# Consumed by `packages/player/ios/fetch-libmpv.sh` (POSIX `.`-sourced, so:
# KEY=value only, no spaces around `=`, no shell expansions; quote any value
# that contains whitespace).
#
# Source of truth: https://github.com/afkcodes/libmpv-darwin-build/releases
# — our fork of media-kit/libmpv-darwin-build, which exists only so the ffmpeg
# configure flags are ours (upstream's audio flavour ships neither the HLS
# demuxer nor any usable audio filter). The
# repo owner is a field in the pin below, not a constant, exactly as on Android
# (`packages/player/android/libmpv.gradle` → `owner`); upstream is 'media-kit'.
#
# Flavour:  `audio` + `default`.
#   - `audio`   → no video codecs / libass / libplacebo (this package is the
#                 audio core; video ships later as a separate plugin).
#   - `default` → FFmpeg built WITHOUT `--enable-gpl` (no x264/x265/smbclient),
#                 i.e. LGPL. Never switch to `full`/`encodersgpl` here: those
#                 are GPL and would relicense every consuming app (PLAN.md §6).
#
# The artifacts are DYNAMIC frameworks (.dylib inside a .framework, embedded and
# re-signed into the app bundle). Dynamic linking is what satisfies the LGPL
# relink obligation on iOS and is the App-Store-accepted pattern (PLAN.md §6).
#
# To bump: query
#   https://api.github.com/repos/${LIBMPV_DARWIN_BUILD_REPO}/releases/latest
# pick the `ios-universal-audio-default` bundle, recompute the SHA-256 of the
# downloaded file, and update TAG + SHA256 + the metadata below together.
# Bumping the *upstream* version means rebasing the fork's `rn-media-hls` branch
# onto the new tag and cutting a new `-rnmedia.N` release; the demuxer flags must
# survive the rebase or `.m3u8` silently regresses to `unsupported-format`, and
# the filter flags must survive it or `setAudioFilters` regresses to
# `{code:'mpv', errno:-11}`.

# GitHub owner/repo of the darwin build scripts. Part of the pin, not a
# constant: we ship from our own fork so the ffmpeg configure flags are under
# our control (see TAG below).
LIBMPV_DARWIN_BUILD_REPO=afkcodes/libmpv-darwin-build

# v0.7.2-rnmedia.2 = upstream v0.7.2 with ffmpeg configure flags added on branch
# `rn-media-hls`, and nothing else. Two generations of delta, both additive:
#
#   rnmedia.1  --enable-demuxer=hls --enable-demuxer=mpegts
#              Upstream's audio flavour builds ffmpeg with `--disable-all` plus
#              an allow-list that carried neither, so every `.m3u8` failed with
#              `unsupported-format` — `--enable-protocol=hls` was present but
#              that is the deprecated `hls://` protocol, useless without the
#              demuxer.
#   rnmedia.2  the 16 LGPL audio EQ/DSP filters (ARCHITECTURE §18):
#              aresample aformat anull volume bass treble lowpass highpass
#              anequalizer superequalizer firequalizer acompressor alimiter
#              dynaudnorm loudnorm crossfeed.
#              Same trap one layer up: the allow-list's filter section held only
#              `overlay` and `equalizer`, so `af=` resolved to nothing even
#              though `--enable-avfilter` and mpv's lavfi bridge were present.
#              `aresample` is NOT optional — libavfilter auto-inserts it on any
#              sample-format disagreement between pads. This makes the iOS
#              filter set identical to Android's `v1.1.9-rnmedia.2`; the two
#              platforms are now at parity, no per-platform EQ branching.
#
# Verified against the RELEASED asset on a Linux host (never the build log —
# ARCHITECTURE → Platform truths):
#   - configure line in the shipped Avutil carries exactly 18 `--enable-filter=`
#     entries (the 16 above + the pre-existing overlay/equalizer), and still
#     `--enable-version3` with neither `--enable-gpl` nor `--enable-nonfree`;
#     `libavutil license: LGPL version 3 or later` is in the binary;
#   - the filters are genuinely compiled in, not merely requested: every one of
#     the 16 filter-name strings and their distinctive AVOptions
#     (`gain_entry`, `asc_level`, `altboundary`, `measured_thresh`, `mgain`,
#     `replaygain_preamp`, superequalizer's `1b`…`18b` + "set 65Hz band gain")
#     are present in Avfilter and all absent from rnmedia.1. NOTE the trap: the
#     bare string `aresample` is present even in rnmedia.1 — it is
#     libavfilter/formats.c:339 `.conversion_filter`, the name of the filter the
#     graph *looks up*. aresample is proven instead by af_aresample.c:164's log
#     format `ch:%d chl:%s fmt:%s r:%dHz -> …`, absent before, present now;
#   - export sets (Mach-O exports trie) are byte-identical to rnmedia.1 for all
#     ten frameworks on both slices — Mpv still exports exactly 53 symbols. No
#     ABI change for anything we link against;
#   - only Avfilter grew: +103,024 B device / +202,112 B simulator, and its
#     *imports* go 113 → 156/158 (`av_tx_init/_uninit`, `av_fifo_*`,
#     `av_expr_parse_and_eval`, `av_opt_get_*`, `av_parse_color`, `av_strtok`)
#     — all already-exported libavutil surface, i.e. exactly the object files
#     the 16 flags pull in and nothing else. Avcodec/Avformat/Avutil/Swresample/
#     Swscale are byte-identical in size; Mpv and the three Mbed* frameworks
#     differ by 48–1112 B purely because embedded /nix/store build paths changed
#     length (checked: the only string deltas are those paths).
# Still LGPLv3: no `--enable-gpl`, no `--enable-nonfree`, no new dependency.
LIBMPV_DARWIN_BUILD_TAG=v0.7.2-rnmedia.2
LIBMPV_DARWIN_BUILD_VARIANT=ios-universal-audio-default

# SHA-256 of
# libmpv-xcframeworks_${TAG}_${VARIANT}.tar.gz
# (computed from the published release asset; re-verified on every download,
# and a mismatch is a hard build failure rather than a warning).
LIBMPV_DARWIN_BUILD_SHA256=bd4de8fbaa7eae4daa1ba3e5fdf8137280ab5655e47f9f0ab2c3394cd22c1cca

# --- metadata (informational; verified by inspecting the binaries) -----------
# All three versions are UNCHANGED from upstream v0.7.2 — the fork's delta is
# ffmpeg configure flags, not a dependency bump.
# mpv                       0.36.0   (MPV_CLIENT_API_VERSION = 2.1)
# FFmpeg                    6.0      (LGPL: no --enable-gpl, --enable-version3)
# mbedTLS                   3.4.1
# xcframework slices        ios-arm64, ios-arm64_x86_64-simulator
# MinimumOSVersion          9.0 (device slice) / 14.0 (simulator slice)
LIBMPV_MPV_VERSION=0.36.0
LIBMPV_FFMPEG_VERSION=6.0
LIBMPV_MBEDTLS_VERSION=3.4.1

# Frameworks expected in the bundle (used as a post-extraction sanity check).
LIBMPV_EXPECTED_FRAMEWORKS="Avcodec Avfilter Avformat Avutil Mbedcrypto Mbedtls Mbedx509 Mpv Swresample Swscale"
