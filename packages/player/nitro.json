{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "rnmediaplayer"
  ],
  "ios": {
    "iosModuleName": "RnMediaPlayer"
  },
  "android": {
    "androidNamespace": [
      "rnmediaplayer"
    ],
    "androidCxxLibName": "RnMediaPlayer"
  },
  "autolinking": {
    "MpvClient": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridMpvClient"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
