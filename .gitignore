# Nitrogen: generated native interfaces ARE committed (see packages/player/package.json
# "files": ["nitrogen", ...]) — this is the create-nitro-module convention. Do not ignore
# packages/*/nitrogen/generated.

# Prebuilt libmpv for iOS: fetched + verified + extracted at `pod install` time by
# packages/player/ios/fetch-libmpv.sh. Binaries are never committed; the tag and
# SHA-256 in packages/player/ios/libmpv.pin are the source of truth.
packages/player/ios/Frameworks/
packages/player/ios/.cache/

# Local-only test fixtures (never committed; see task notes)
apps/example/*.local.ts
apps/example/*.local.tsx
